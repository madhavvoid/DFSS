PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/dfss
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=1d
NODE_SHARED_SECRET=replace-this-with-a-different-long-random-secret
CORS_ORIGIN=http://localhost:5173
CHUNK_SIZE_MB=8
REPLICATION_FACTOR=3
MAX_FILE_SIZE_MB=1024
NODE_TIMEOUT_MS=5000
HEARTBEAT_INTERVAL_MS=5000
NODE_OFFLINE_AFTER_MS=20000